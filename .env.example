# Copy to .env for local development. Never commit .env.

APP_ENV=local
AUTH_MODE=local

DATABASE_URL=postgresql+asyncpg://chat:chat@db:5432/chat
DB_AUTH_MODE=password

# AI providers: fake needs no key
LLM_DEFAULT=fake
LLM_FALLBACKS=

GEMINI_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

BEDROCK_ENABLED=false
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
AWS_REGION=us-east-1

# Needed only when AUTH_MODE=cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Limits
MAX_MESSAGE_CHARS=4000
MAX_OUTPUT_TOKENS=8000
DAILY_USER_MESSAGE_LIMIT=30
DAILY_GLOBAL_MESSAGE_LIMIT=200

# Local S3 (SeaweedFS). Docker Compose sets S3_ENDPOINT_URL, SMTP_HOST and SMTP_PORT.
S3_BUCKET=chat-app-local
